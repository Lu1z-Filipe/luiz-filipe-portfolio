{
  "name": "luiz-filipe-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfólio profissional de QA com estudos técnicos de automação (API, Web, SQL) e pipeline de CI/CD.",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "workspaces": ["site", "projects/api-tests", "projects/web-tests", "projects/sql-validation"],
  "scripts": {
    "lint": "eslint .",
    "scan": "node scripts/check-secrets.mjs",
    "build": "npm run build -w site",
    "test:site": "npm run test -w site",
    "test:api": "npm run test -w projects/api-tests",
    "test:web": "npm run test -w projects/web-tests",
    "test:sql": "npm run test -w projects/sql-validation",
    "test": "npm run test:api && npm run test:sql && npm run test:web && npm run test:site"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
